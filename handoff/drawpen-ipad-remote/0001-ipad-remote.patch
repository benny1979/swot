+console.log('[DRAWPEN]: Remote Page preloading...');
+
+const { contextBridge, ipcRenderer } = require('electron');
+
+contextBridge.exposeInMainWorld('electronAPI', {
+  // Renderer -> Main
+  getState: () => ipcRenderer.invoke('remote_get_state'),
+  setRelayUrl: (value) => ipcRenderer.invoke('remote_set_relay_url', value),
+  setEnabled: (value) => ipcRenderer.invoke('remote_set_enabled', value),
+  newRoom: () => ipcRenderer.invoke('remote_new_room'),
+
+  // Main -> Renderer
+  onState: (callback) => ipcRenderer.on('remote_state', callback),
+});
