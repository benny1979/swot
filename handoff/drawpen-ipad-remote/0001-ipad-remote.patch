index 0000000..e0aded3
--- /dev/null
+++ b/remote/relay/src/index.js
@@ -0,0 +1,91 @@
+// Relay between one DrawPen host (Windows) and one iPad per room.
+// Rooms are Durable Objects keyed by a 128-bit id from the pairing QR code.
+// Messages are forwarded as-is; the relay keeps no state beyond open sockets.
+
+import { DurableObject } from 'cloudflare:workers';
+
+const ROLES = ['host', 'pad'];
+const otherRole = (role) => (role === 'host' ? 'pad' : 'host');
+
+export class Room extends DurableObject {
+  constructor(ctx, env) {
+    super(ctx, env);
+    // Keepalive pings are answered without waking the object
+    ctx.setWebSocketAutoResponse(new WebSocketRequestResponsePair('ping', 'pong'));
+  }
+
+  async fetch(request) {
+    const role = new URL(request.url).searchParams.get('role');
+    if (!ROLES.includes(role)) {
+      return new Response('Invalid role', { status: 400 });
+    }
+
+    // One socket per role: a new connection replaces the old one
+    for (const old of this.ctx.getWebSockets(role)) {
+      try { old.close(4000, 'Replaced'); } catch (_) {}
+    }
+
+    const [client, server] = Object.values(new WebSocketPair());
+    this.ctx.acceptWebSocket(server, [role]);
+
+    const other = otherRole(role);
+    server.send(JSON.stringify({ t: 'peer', role: other, connected: this.openSockets(other).length > 0 }));
+    this.send(other, JSON.stringify({ t: 'peer', role, connected: true }));
+
+    return new Response(null, { status: 101, webSocket: client });
+  }
+
+  webSocketMessage(ws, message) {
+    const [role] = this.ctx.getTags(ws);
+    this.send(otherRole(role), message);
+  }
+
+  webSocketClose(ws, code) {
+    this.dropped(ws);
+    try { ws.close(code === 1005 ? 1000 : code, 'Closed'); } catch (_) {}
+  }
+
+  webSocketError(ws) {
+    this.dropped(ws);
+  }
+
+  dropped(ws) {
+    const [role] = this.ctx.getTags(ws);
+    const stillConnected = this.openSockets(role).some((socket) => socket !== ws);
+
+    if (!stillConnected) {
+      this.send(otherRole(role), JSON.stringify({ t: 'peer', role, connected: false }));
+    }
+  }
+
+  openSockets(role) {
+    return this.ctx.getWebSockets(role).filter((socket) => socket.readyState === WebSocket.OPEN);
+  }
+
+  send(role, message) {
+    for (const socket of this.openSockets(role)) {
+      try { socket.send(message); } catch (_) {}
+    }
+  }
+}
+
+export default {
+  async fetch(request, env) {
+    const url = new URL(request.url);
+
+    if (url.pathname === '/ws') {
+      if (request.headers.get('Upgrade') !== 'websocket') {
+        return new Response('Expected WebSocket', { status: 426 });
+      }
+
+      const room = url.searchParams.get('room') || '';
+      if (!/^[a-f0-9]{32}$/.test(room)) {
+        return new Response('Invalid room', { status: 400 });
+      }
+
+      return env.ROOMS.get(env.ROOMS.idFromName(room)).fetch(request);
+    }
+
+    return env.ASSETS.fetch(request);
+  },
+};
