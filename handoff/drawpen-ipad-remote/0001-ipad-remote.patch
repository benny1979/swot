+++ b/src/renderer/remote_page/index.js
@@ -0,0 +1,63 @@
+console.log('[DRAWPEN]: Remote Page loading...');
+
+const STATUS_TEXT = {
+  disconnected: 'Disconnected',
+  no_relay: 'Set a valid relay URL',
+  connecting: 'Connecting to relay...',
+  waiting: 'Waiting for iPad',
+  paired: 'iPad connected',
+};
+
+const STATUS_CLASS = {
+  no_relay: 'error',
+  waiting: 'waiting',
+  paired: 'paired',
+};
+
+const $ = (id) => document.getElementById(id);
+
+let enabled = false;
+
+function render(state) {
+  enabled = state.enabled;
+
+  if (document.activeElement !== $('relay')) {
+    $('relay').value = state.relayUrl;
+  }
+
+  $('dot').className = STATUS_CLASS[state.status] || '';
+  $('status-text').innerText = STATUS_TEXT[state.status] || state.status;
+  $('toggle').innerText = enabled ? 'Disconnect' : 'Connect';
+
+  $('pairing').hidden = !(enabled && state.padUrl);
+  if (state.qrDataUrl) $('qr').src = state.qrDataUrl;
+  $('url').innerText = state.padUrl || '';
+}
+
+async function refresh() {
+  render(await window.electronAPI.getState());
+}
+
+$('save').addEventListener('click', async () => {
+  await window.electronAPI.setRelayUrl($('relay').value);
+  $('relay').blur();
+  refresh();
+});
+
+$('relay').addEventListener('keydown', (event) => {
+  if (event.key === 'Enter') $('save').click();
+});
+
+$('toggle').addEventListener('click', async () => {
+  await window.electronAPI.setEnabled(!enabled);
+  refresh();
+});
+
+$('new-room').addEventListener('click', async () => {
+  await window.electronAPI.newRoom();
+  refresh();
+});
+
+window.electronAPI.onState((_event, state) => render(state));
+
+refresh();
