new file mode 100644
index 0000000..d7b3cb2
--- /dev/null
+++ b/remote/relay/public/index.html
@@ -0,0 +1,589 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
+<meta name="apple-mobile-web-app-capable" content="yes">
+<meta name="mobile-web-app-capable" content="yes">
+<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
+<meta name="apple-mobile-web-app-title" content="DrawPen">
+<title>DrawPen Remote</title>
+<style>
+  :root {
+    --bg: #111214;
+    --bar: #1c1d21;
+    --btn: #2a2c31;
+    --btn-on: #529BE0;
+    --text: #e8e8ea;
+    --muted: #8a8c93;
+  }
+  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
+  html, body {
+    margin: 0; height: 100%; overflow: hidden; background: var(--bg); color: var(--text);
+    font: 13px -apple-system, system-ui, sans-serif;
+    -webkit-user-select: none; user-select: none; -webkit-touch-callout: none;
+    overscroll-behavior: none; touch-action: manipulation;
+  }
+  #app { display: flex; height: 100%; padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left); }
+  #bar {
+    width: 116px; flex: none; background: var(--bar); overflow-y: auto; touch-action: pan-y;
+    display: grid; grid-template-columns: 48px 48px; gap: 6px; justify-content: center; align-content: start; padding: 8px 0;
+  }
+  #bar > div:not(#status) { display: contents; }
+  #bar hr { grid-column: 1 / -1; width: 100%; border: 0; border-top: 1px solid #333; margin: 2px 0; }
+  #bar button {
+    width: 48px; height: 44px; flex: none; border: 0; border-radius: 10px; background: var(--btn); color: var(--text);
+    font: 600 18px -apple-system, system-ui, sans-serif; display: grid; place-items: center; padding: 0;
+  }
+  #bar button small { font-size: 9px; font-weight: 500; display: block; color: var(--muted); margin-top: -2px; }
+  #bar button.on { background: var(--btn-on); }
+  #bar button.on small { color: var(--text); }
+  #bar button:disabled { opacity: .35; }
+  .swatch { width: 36px !important; height: 36px !important; border-radius: 50% !important; border: 3px solid var(--bar) !important; box-shadow: 0 0 0 1px #555; justify-self: center; align-self: center; }
+  .swatch.on { box-shadow: 0 0 0 2px var(--text); }
+  .swatch.rainbow { background: conic-gradient(red, yellow, lime, cyan, blue, magenta, red) !important; }
+  .dot { border-radius: 50%; background: var(--text); display: block; }
+  #status { grid-column: 1 / -1; justify-self: center; width: 12px; height: 12px; border-radius: 50%; background: #E05252; margin: 2px 0; }
+  #status.waiting { background: #E0A552; }
+  #status.ok { background: #52E06C; }
+  #stage { position: relative; flex: 1; overflow: hidden; touch-action: none; }
+  #stage canvas { position: absolute; }
+  #shot { background: #000; }
+  #ink { touch-action: none; }
+  #msg {
+    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; text-align: center;
+    font-size: 16px; pointer-events: none; padding: 24px;
+  }
+  #msg span { background: rgba(0, 0, 0, .75); color: var(--text); padding: 10px 16px; border-radius: 10px; }
+</style>
+</head>
+<body>
+<div id="app">
+  <div id="bar">
+    <div id="status" title="Connection"></div>
+    <div id="tools"></div>
+    <hr>
+    <div id="colors"></div>
+    <hr>
+    <div id="widths"></div>
+    <hr>
+    <button id="undo" title="Undo">↶</button>
+    <button id="redo" title="Redo">↷</button>
+    <button id="clear" title="Clear all">✕<small>clear</small></button>
+    <hr>
+    <button id="overlay" title="Show/hide overlay on PC">◐<small>overlay</small></button>
+    <button id="board" title="Toggle whiteboard">▢<small>board</small></button>
+    <button id="finger" title="Allow finger drawing">☝<small>finger</small></button>
+    <button id="refresh" title="Refresh screen image">⟳</button>
+  </div>
+  <div id="stage">
+    <canvas id="shot"></canvas>
+    <canvas id="ink"></canvas>
+    <div id="msg"><span>Connecting…</span></div>
+  </div>
+</div>
+
+<script>
+'use strict';
+
+// Must match DrawPen constants.js (widthList, highlighterAlpha)
+const WIDTHS = {
+  pen:         [4, 8, 12, 16],
+  highlighter: [8, 16, 24, 32],
+  figure:      [4, 6, 8, 10],
+  laser:       [5, 8, 12, 16],
+};
+const HIGHLIGHTER_ALPHA = 0.35;
+const LOCAL_FADE_MS = 1500;          // fadepen / laser local preview lifetime
+const LOCAL_STALE_MS = 8000;         // drop local ink if no frame confirms it
+const PING_MS = 20000;
+
+const TOOLS = [
+  { id: 'pen',         icon: '✎', label: 'pen' },
+  { id: 'fadepen',     icon: '✎', label: 'fade' },
+  { id: 'highlighter', icon: '▌', label: 'high' },
+  { id: 'laser',       icon: '✦', label: 'laser' },
+  { id: 'arrow',       icon: '→', label: 'arrow' },
+  { id: 'line',        icon: '╱', label: 'line' },
+  { id: 'rectangle',   icon: '▭', label: 'rect' },
+  { id: 'oval',        icon: '◯', label: 'oval' },
+  { id: 'eraser',      icon: '⌫', label: 'erase' },
+];
+
+const $ = (id) => document.getElementById(id);
+const room = new URLSearchParams(location.hash.slice(1)).get('room') || '';
+
+// ---- State ----
+const saved = load();
+const state = {
+  tool: TOOLS.some(t => t.id === saved.tool) ? saved.tool : 'pen',
+  color: Number.isInteger(saved.color) ? saved.color : 1,
+  width: Number.isInteger(saved.width) ? saved.width : 1,
+  finger: Boolean(saved.finger),
+  colors: ['#000000', '#529BE0', '#E05252', '#52E06C', '#E0A552', '#FFFFFF', '#1E1E1E'],
+  hostW: 16, hostH: 9,
+  hostOnline: false,
+  overlay: true,
+};
+
+function load() {
+  try { return JSON.parse(localStorage.getItem('drawpen-remote') || '{}'); } catch (_) { return {}; }
+}
+function save() {
+  try {
+    localStorage.setItem('drawpen-remote', JSON.stringify({ tool: state.tool, color: state.color, width: state.width, finger: state.finger }));
+  } catch (_) {}
+}
+
+// ---- Connection ----
+let ws = null;
+let retryMs = 1000;
+let pendingFrame = null;
+
+function connect() {
+  if (!/^[a-f0-9]{32}$/.test(room)) {
+    setMessage('No pairing code. Scan the QR code shown by DrawPen on the PC.');
+    return;
+  }
+
+  const url = `${location.protocol === 'http:' ? 'ws' : 'wss'}://${location.host}/ws?room=${room}&role=pad`;
+  const socket = new WebSocket(url);
+  socket.binaryType = 'arraybuffer';
+  ws = socket;
+  setStatus();
+
+  socket.onopen = () => {
+    retryMs = 1000;
+    setStatus();
+  };
+
+  socket.onmessage = (event) => {
+    if (typeof event.data !== 'string') {
+      handleFrame(event.data);
+      return;
+    }
+    if (event.data === 'pong') return;
+
+    let message;
+    try { message = JSON.parse(event.data); } catch (_) { return; }
+    handleMessage(message);
+  };
+
+  socket.onclose = () => {
+    if (ws !== socket) return;
+    ws = null;
+    state.hostOnline = false;
+    setStatus();
+    setTimeout(connect, retryMs);
+    retryMs = Math.min(retryMs * 2, 15000);
+  };
+}
+
+function send(message) {
+  if (ws && ws.readyState === WebSocket.OPEN) ws.send(JSON.stringify(message));
+}
+
+setInterval(() => ws && ws.readyState === WebSocket.OPEN && ws.send('ping'), PING_MS);
+
+function handleMessage(message) {
+  switch (message.t) {
+    case 'peer':
+      if (message.role !== 'host') return;
+      state.hostOnline = Boolean(message.connected);
+      setStatus();
+      if (state.hostOnline) send({ t: 'hi' });
+      break;
+    case 'hello':
+      state.hostOnline = true;
+      if (Array.isArray(message.colors)) state.colors = ['#000000', ...message.colors];
+      if (typeof message.overlay === 'boolean') state.overlay = message.overlay;
+      setHostSize(message.w, message.h);
+      sendToolState();
+      renderBar();
+      setStatus();
+      break;
+    case 'overlay_state':
+      state.overlay = Boolean(message.visible);
+      renderBar();
+      break;
+    case 'frame':
+      pendingFrame = message;
+      break;
+  }
+}
+
+function sendToolState() {
+  send({ t: 'tool', tool: state.tool });
+  send({ t: 'color', index: state.color });
+  send({ t: 'width', index: state.width });
+}
+
+async function handleFrame(data) {
+  const meta = pendingFrame;
+  pendingFrame = null;
+  if (!meta) return;
+
+  let bitmap;
+  try {
+    bitmap = await createImageBitmap(new Blob([data], { type: 'image/jpeg' }));
+  } catch (_) {
+    return;
+  }
+
+  setHostSize(meta.w, meta.h);
+  const ctx = shot.getContext('2d');
+  ctx.drawImage(bitmap, 0, 0, shot.width, shot.height);
+  bitmap.close && bitmap.close();
+
+  // Strokes the PC has applied are now in the image
+  strokes = strokes.filter(s => !s.done || s.seq > meta.seq);
+  hasFrame = true;
+  setStatus();
+  drawInk();
+}
+
+function setStatus() {
+  const el = $('status');
+  if (!ws || ws.readyState !== WebSocket.OPEN) {
+    el.className = '';
+    setMessage(room ? 'Connecting to relay…' : '');
+  } else if (!state.hostOnline) {
+    el.className = 'waiting';
+    setMessage('PC is offline. Open DrawPen → iPad Remote → Connect.');
+  } else {
+    el.className = 'ok';
+    setMessage(hasFrame ? '' : 'Waiting for screen…');
+  }
+}
+
+function setMessage(text) {
+  $('msg').firstElementChild.textContent = text;
+  $('msg').style.display = text ? 'flex' : 'none';
+}
+
+// ---- Layout ----
+const stage = $('stage');
+const shot = $('shot');
+const ink = $('ink');
+let hasFrame = false;
+let fit = { x: 0, y: 0, w: 1, h: 1 };
+
+function setHostSize(w, h) {
+  if (!(w > 0 && h > 0)) return;
+  if (w === state.hostW && h === state.hostH) return;
+  state.hostW = w;
+  state.hostH = h;
+  layout();
+}
+
+function layout() {
+  const sw = stage.clientWidth;
+  const sh = stage.clientHeight;
+  const scale = Math.min(sw / state.hostW, sh / state.hostH);
+  const w = Math.floor(state.hostW * scale);
+  const h = Math.floor(state.hostH * scale);
+  fit = { x: Math.floor((sw - w) / 2), y: Math.floor((sh - h) / 2), w, h };
+
+  const dpr = window.devicePixelRatio || 1;
+  for (const canvas of [shot, ink]) {
+    canvas.style.left = fit.x + 'px';
+    canvas.style.top = fit.y + 'px';
+    canvas.style.width = w + 'px';
+    canvas.style.height = h + 'px';
+    canvas.width = Math.round(w * dpr);
+    canvas.height = Math.round(h * dpr);
+  }
+  hasFrame = false; // canvas was cleared; next frame repaints
+  send({ t: 'frame' });
+  setStatus();
+  drawInk();
+}
+
+window.addEventListener('resize', layout);
+
+// ---- Toolbar ----
+function button(html, title, onClick, extraClass = '') {
+  const el = document.createElement('button');
+  el.innerHTML = html;
+  el.title = title;
+  if (extraClass) el.className = extraClass;
+  el.addEventListener('click', onClick);
+  return el;
+}
+
+function renderBar() {
+  const tools = $('tools');
+  tools.replaceChildren(...TOOLS.map(tool => {
+    const el = button(`<span>${tool.icon}<small>${tool.label}</small></span>`, tool.id, () => setTool(tool.id));
+    el.classList.toggle('on', state.tool === tool.id);
+    return el;
+  }));
+
+  $('colors').replaceChildren(...state.colors.map((color, index) => {
+    const el = button('', index === 0 ? 'Rainbow' : color, () => setColor(index), 'swatch');
+    if (index === 0) el.classList.add('rainbow');
+    else el.style.background = color;
+    el.classList.toggle('on', state.color === index);
+    return el;
+  }));
+
+  $('widths').replaceChildren(...WIDTHS.pen.map((size, index) => {
+    const el = button(`<span class="dot" style="width:${size}px;height:${size}px"></span>`, `Width ${index + 1}`, () => setWidth(index));
+    el.classList.toggle('on', state.width === index);
+    return el;
+  }));
+
+  $('finger').classList.toggle('on', state.finger);
+  $('overlay').classList.toggle('on', state.overlay);
+}
+
+function setTool(tool) { state.tool = tool; save(); send({ t: 'tool', tool }); renderBar(); }
+function setColor(index) { state.color = index; save(); send({ t: 'color', index }); renderBar(); }
+function setWidth(index) { state.width = index; save(); send({ t: 'width', index }); renderBar(); }
+
+$('undo').addEventListener('click', () => send({ t: 'undo' }));
+$('redo').addEventListener('click', () => send({ t: 'redo' }));
+$('clear').addEventListener('click', () => {
+  if (confirm('Clear all drawings? This cannot be undone.')) {
+    strokes = [];
+    drawInk();
+    send({ t: 'clear' });
+  }
+});
+$('overlay').addEventListener('click', () => send({ t: 'overlay', visible: !state.overlay }));
+$('board').addEventListener('click', () => send({ t: 'whiteboard' }));
+$('finger').addEventListener('click', () => { state.finger = !state.finger; save(); renderBar(); });
+$('refresh').addEventListener('click', () => send({ t: 'frame' }));
+
+// ---- Input ----
+let strokes = [];
+let active = null;
+let pendingPoints = [];
+let flushScheduled = false;
+let seq = Date.now(); // monotonic across reloads; echoed back in frames
+
+function allowed(event) {
+  if (event.pointerType === 'pen' || event.pointerType === 'mouse') return true;
+  return state.finger;
+}
+
+function normalize(event) {
+  const rect = ink.getBoundingClientRect();
+  const x = Math.min(Math.max((event.clientX - rect.left) / rect.width, 0), 1);
+  const y = Math.min(Math.max((event.clientY - rect.top) / rect.height, 0), 1);
+  return [Math.round(x * 1e4) / 1e4, Math.round(y * 1e4) / 1e4];
+}
+
+ink.addEventListener('pointerdown', (event) => {
+  if (active || !allowed(event) || !state.hostOnline) return;
+  event.preventDefault();
+  ink.setPointerCapture(event.pointerId);
+
+  const point = normalize(event);
+  active = {
+    pointerId: event.pointerId,
+    seq: ++seq,
+    tool: state.tool,
+    color: state.color,
+    width: state.width,
+    points: [point],
+    done: false,
+    endedAt: 0,
+  };
+  strokes.push(active);
+  send({ t: 'down', p: point });
+  requestDraw();
+});
+
+ink.addEventListener('pointermove', (event) => {
+  if (!active || event.pointerId !== active.pointerId) return;
+  event.preventDefault();
+
+  const events = event.getCoalescedEvents ? event.getCoalescedEvents() : [event];
+  for (const e of (events.length ? events : [event])) {
+    const point = normalize(e);
+    active.points.push(point);
+    pendingPoints.push(point);
+  }
+  scheduleFlush();
+  requestDraw();
+});
+
+function endStroke(event) {
+  if (!active || event.pointerId !== active.pointerId) return;
+  event.preventDefault();
+
+  flushPoints();
+  const last = active.points[active.points.length - 1];
+  send({ t: 'up', p: last, seq: active.seq });
+  active.done = true;
+  active.endedAt = performance.now();
+  active = null;
+  requestDraw();
+}
+
+ink.addEventListener('pointerup', endStroke);
+ink.addEventListener('pointercancel', endStroke);
+
+function scheduleFlush() {
+  if (flushScheduled) return;
+  flushScheduled = true;
+  requestAnimationFrame(flushPoints);
+}
+
+function flushPoints() {
+  flushScheduled = false;
+  if (!pendingPoints.length) return;
+  send({ t: 'move', pts: pendingPoints });
+  pendingPoints = [];
+}
+
+// Block iOS gestures (scroll, zoom, magnifier) on the drawing surface
+for (const type of ['touchstart', 'touchmove', 'gesturestart', 'gesturechange']) {
+  ink.addEventListener(type, (event) => event.preventDefault(), { passive: false });
+}
+
+// ---- Local ink (preview until the next frame shows the real result) ----
+let drawRequested = false;
+
+function requestDraw() {
+  if (drawRequested) return;
+  drawRequested = true;
+  requestAnimationFrame(() => {
+    drawRequested = false;
+    drawInk();
+  });
+}
+
+function drawInk() {
+  const ctx = ink.getContext('2d');
+  const dpr = window.devicePixelRatio || 1;
+  const now = performance.now();
+  ctx.setTransform(1, 0, 0, 1, 0, 0);
+  ctx.clearRect(0, 0, ink.width, ink.height);
+  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+
+  const scale = fit.w / state.hostW; // host px -> iPad css px
+  let animating = false;
+
+  strokes = strokes.filter(s => {
+    if (!s.done) return true;
+    const age = now - s.endedAt;
+    if (s.tool === 'laser' || s.tool === 'fadepen') return age < LOCAL_FADE_MS;
+    return age < LOCAL_STALE_MS;
+  });
+
+  for (const s of strokes) {
+    let alpha = 1;
+    if (s.done && (s.tool === 'laser' || s.tool === 'fadepen')) {
+      alpha = Math.max(0, 1 - (now - s.endedAt) / LOCAL_FADE_MS);
+      animating = true;
+    }
+    drawStroke(ctx, s, scale, alpha);
+  }
+
+  if (animating || strokes.some(s => s.done)) requestDraw();
+}
+
+function strokeColor(s, ctx) {
+  if (s.tool === 'laser') return '#ff3b30';
+  if (s.tool === 'eraser') return 'rgba(140,140,140,0.6)';
+  if (s.color === 0) {
+    const [a, b] = [s.points[0], s.points[s.points.length - 1]];
+    const g = ctx.createLinearGradient(a[0] * fit.w, a[1] * fit.h, b[0] * fit.w + 1, b[1] * fit.h + 1);
+    g.addColorStop(0, 'hsl(0,90%,60%)');
+    g.addColorStop(0.5, 'hsl(180,90%,60%)');
+    g.addColorStop(1, 'hsl(300,90%,60%)');
+    return g;
+  }
+  return state.colors[s.color] || '#ffffff';
+}
+
+function drawStroke(ctx, s, scale, alpha) {
+  const pts = s.points.map(([x, y]) => [x * fit.w, y * fit.h]);
+  ctx.save();
+  ctx.globalAlpha = alpha;
+  ctx.lineCap = 'round';
+  ctx.lineJoin = 'round';
+  ctx.strokeStyle = strokeColor(s, ctx);
+
+  switch (s.tool) {
+    case 'highlighter':
+      ctx.globalAlpha = alpha * HIGHLIGHTER_ALPHA;
+      ctx.lineWidth = WIDTHS.highlighter[s.width] * scale;
+      polyline(ctx, pts);
+      break;
+    case 'laser':
+      ctx.shadowColor = '#ff3b30';
+      ctx.shadowBlur = 8;
+      ctx.lineWidth = WIDTHS.laser[s.width] * scale;
+      polyline(ctx, pts);
+      break;
+    case 'eraser':
+      ctx.lineWidth = 6;
+      ctx.setLineDash([6, 6]);
+      polyline(ctx, pts);
+      break;
+    case 'arrow':
+    case 'line':
+    case 'rectangle':
+    case 'oval':
+      ctx.lineWidth = WIDTHS.figure[s.width] * scale;
+      shape(ctx, s.tool, pts[0], pts[pts.length - 1]);
+      break;
+    default: // pen, fadepen
+      ctx.lineWidth = WIDTHS.pen[s.width] * scale;
+      polyline(ctx, pts);
+  }
+  ctx.restore();
+}
+
+function polyline(ctx, pts) {
+  ctx.beginPath();
+  ctx.moveTo(pts[0][0], pts[0][1]);
+  if (pts.length === 1) {
+    ctx.lineTo(pts[0][0] + 0.01, pts[0][1]);
+  }
+  for (let i = 1; i < pts.length - 1; i++) {
+    const mx = (pts[i][0] + pts[i + 1][0]) / 2;
+    const my = (pts[i][1] + pts[i + 1][1]) / 2;
+    ctx.quadraticCurveTo(pts[i][0], pts[i][1], mx, my);
+  }
+  if (pts.length > 1) ctx.lineTo(pts[pts.length - 1][0], pts[pts.length - 1][1]);
+  ctx.stroke();
+}
+
+function shape(ctx, tool, a, b) {
+  ctx.beginPath();
+  if (tool === 'rectangle') {
+    ctx.rect(Math.min(a[0], b[0]), Math.min(a[1], b[1]), Math.abs(b[0] - a[0]), Math.abs(b[1] - a[1]));
+  } else if (tool === 'oval') {
+    ctx.ellipse((a[0] + b[0]) / 2, (a[1] + b[1]) / 2, Math.abs(b[0] - a[0]) / 2, Math.abs(b[1] - a[1]) / 2, 0, 0, Math.PI * 2);
+  } else {
+    ctx.moveTo(a[0], a[1]);
+    ctx.lineTo(b[0], b[1]);
+    if (tool === 'arrow') {
+      const angle = Math.atan2(b[1] - a[1], b[0] - a[0]);
+      const head = Math.max(12, ctx.lineWidth * 3);
+      for (const side of [-1, 1]) {
+        ctx.moveTo(b[0], b[1]);
+        ctx.lineTo(b[0] - head * Math.cos(angle + side * Math.PI / 7), b[1] - head * Math.sin(angle + side * Math.PI / 7));
+      }
+    }
+  }
+  ctx.stroke();
+}
+
+// ---- Keep the iPad awake while presenting ----
+async function keepAwake() {
+  try { await navigator.wakeLock?.request('screen'); } catch (_) {}
+}
+document.addEventListener('visibilitychange', () => document.visibilityState === 'visible' && keepAwake());
+
+renderBar();
+layout();
+keepAwake();
+connect();
+</script>
+</body>
+</html>
