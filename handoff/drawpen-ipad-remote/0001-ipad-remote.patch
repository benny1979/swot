diff --git a/src/main/remote.js b/src/main/remote.js
new file mode 100644
index 0000000..3e4ef9a
--- /dev/null
+++ b/src/main/remote.js
@@ -0,0 +1,338 @@
+// iPad Remote: connects to a relay (see remote/relay) so an iPad can draw on the overlay.
+// The iPad sends normalized pointer input; we send back periodic JPEG screenshots of the drawing display.
+
+import { desktopCapturer } from 'electron';
+import { randomBytes, createHash } from 'crypto';
+import QRCode from 'qrcode';
+
+const FRAME_INTERVAL_MS = 1000;
+const FRAME_AFTER_INPUT_MS = 200;
+const FRAME_MAX_WIDTH = 1600;
+const FRAME_MAX_BYTES = 900 * 1024; // Relay message limit is 1 MiB
+const PING_INTERVAL_MS = 20000;
+const RECONNECT_MAX_MS = 30000;
+
+const INPUT_MESSAGES = ['down', 'move', 'up', 'tool', 'color', 'width', 'undo', 'redo'];
+const COMMAND_MESSAGES = ['clear', 'whiteboard', 'overlay', 'frame'];
+
+export function createRemoteBridge({ store, log, getDrawingDisplay, getHelloInfo, onInput, onCommand, onStateChange }) {
+  let ws = null;
+  let wanted = false;
+  let status = 'disconnected'; // disconnected | no_relay | connecting | waiting | paired
+  let padConnected = false;
+  let reconnectTimer = null;
+  let reconnectDelay = 1000;
+  let pingTimer = null;
+  let frameTimer = null;
+  let frameSoonTimer = null;
+  let capturing = false;
+  let lastUpSeq = 0;
+  let lastSent = { hash: null, seq: -1 };
+
+  function roomId() {
+    let id = store.get('remote_room_id');
+
+    if (!/^[a-f0-9]{32}$/.test(id || '')) {
+      id = randomBytes(16).toString('hex');
+      store.set('remote_room_id', id);
+    }
+
+    return id;
+  }
+
+  function relayUrl() {
+    const value = (store.get('remote_relay_url') || '').trim().replace(/\/+$/, '');
+
+    try {
+      const url = new URL(value);
+      return ['https:', 'http:'].includes(url.protocol) ? url.origin : null;
+    } catch (_) {
+      return null;
+    }
+  }
+
+  function padUrl() {
+    const base = relayUrl();
+
+    return base ? `${base}/#room=${roomId()}` : null;
+  }
+
+  function wsUrl() {
+    const url = new URL(relayUrl());
+    url.protocol = url.protocol === 'http:' ? 'ws:' : 'wss:';
+    url.pathname = '/ws';
+    url.search = `?room=${roomId()}&role=host`;
+
+    return url.toString();
+  }
+
+  function setStatus(newStatus) {
+    status = newStatus;
+    onStateChange();
+  }
+
+  function isOpen() {
+    return ws && ws.readyState === WebSocket.OPEN;
+  }
+
+  function sendJson(message) {
+    if (isOpen()) ws.send(JSON.stringify(message));
+  }
+
+  function open() {
+    clearTimeout(reconnectTimer);
+
+    if (!wanted) return;
+
+    if (!relayUrl()) {
+      setStatus('no_relay');
+      return;
+    }
+
+    setStatus('connecting');
+
+    let socket;
+    try {
+      socket = new WebSocket(wsUrl());
+    } catch (error) {
+      log('Remote: connect failed', error.message);
+      scheduleReconnect();
+      return;
+    }
+
+    socket.binaryType = 'arraybuffer';
+    ws = socket;
+
+    socket.onopen = () => {
+      if (ws !== socket) return;
+
+      reconnectDelay = 1000;
+      clearInterval(pingTimer);
+      pingTimer = setInterval(() => isOpen() && ws.send('ping'), PING_INTERVAL_MS);
+      setStatus(padConnected ? 'paired' : 'waiting');
+    };
+
+    socket.onmessage = (event) => {
+      if (ws !== socket || typeof event.data !== 'string' || event.data === 'pong') return;
+
+      let message;
+      try {
+        message = JSON.parse(event.data);
+      } catch (_) {
+        return;
+      }
+
+      handleMessage(message);
+    };
+
+    socket.onclose = () => {
+      if (ws !== socket) return;
+
+      ws = null;
+      clearInterval(pingTimer);
+      setPadConnected(false);
+      scheduleReconnect();
+    };
+
+    socket.onerror = () => {}; // onclose follows
+  }
+
+  function scheduleReconnect() {
+    if (!wanted) {
+      setStatus('disconnected');
+      return;
+    }
+
+    setStatus('connecting');
+    clearTimeout(reconnectTimer);
+    reconnectTimer = setTimeout(open, reconnectDelay);
+    reconnectDelay = Math.min(reconnectDelay * 2, RECONNECT_MAX_MS);
+  }
+
+  function close() {
+    clearTimeout(reconnectTimer);
+    clearInterval(pingTimer);
+    setPadConnected(false);
+
+    if (ws) {
+      const socket = ws;
+      ws = null;
+      try { socket.close(1000, 'bye'); } catch (_) {}
+    }
+  }
+
+  function setPadConnected(value) {
+    padConnected = value;
+
+    if (padConnected) {
+      lastSent = { hash: null, seq: -1 };
+      sendHello();
+      clearInterval(frameTimer);
+      frameTimer = setInterval(() => captureAndSend(false), FRAME_INTERVAL_MS);
+      captureAndSend(true);
+    } else {
+      clearInterval(frameTimer);
+      clearTimeout(frameSoonTimer);
+      frameTimer = null;
+    }
+
+    if (isOpen()) setStatus(padConnected ? 'paired' : 'waiting');
+  }
+
+  function handleMessage(message) {
+    if (message.t === 'peer') {
+      if (message.role === 'pad') setPadConnected(Boolean(message.connected));
+      return;
+    }
+
+    if (message.t === 'hi') {
+      sendHello();
+      captureAndSend(true);
+      return;
+    }
+
+    if (INPUT_MESSAGES.includes(message.t)) {
+      if (message.t === 'up' && Number.isInteger(message.seq)) {
+        lastUpSeq = message.seq;
+      }
+
+      onInput(message);
+
+      if (['up', 'undo', 'redo'].includes(message.t)) frameSoon();
+      return;
+    }
+
+    if (COMMAND_MESSAGES.includes(message.t)) {
+      if (message.t === 'frame') {
+        captureAndSend(true);
+        return;
+      }
+
+      onCommand(message);
+      frameSoon();
+    }
+  }
+
+  function sendHello() {
+    const display = getDrawingDisplay();
+
+    sendJson({
+      t: 'hello',
+      w: display.workArea.width,
+      h: display.workArea.height,
+      ...getHelloInfo(),
+    });
+  }
+
+  function sendOverlayState(visible) {
+    sendJson({ t: 'overlay_state', visible });
+  }
+
+  function frameSoon() {
+    clearTimeout(frameSoonTimer);
+    frameSoonTimer = setTimeout(() => captureAndSend(true), FRAME_AFTER_INPUT_MS);
+  }
+
+  async function captureAndSend(force) {
+    if (capturing || !padConnected || !isOpen()) return;
+
+    capturing = true;
+    const seq = lastUpSeq;
+
+    try {
+      const display = getDrawingDisplay();
+      const scaleFactor = display.scaleFactor || 1;
+
+      const sources = await desktopCapturer.getSources({
+        types: ['screen'],
+        thumbnailSize: {
+          width: Math.round(display.size.width * scaleFactor),
+          height: Math.round(display.size.height * scaleFactor),
+        },
+      });
+
+      const source =
+        sources.find(s => String(s.display_id ?? '') === String(display.id)) ||
+        sources[0];
+
+      if (!source || source.thumbnail.isEmpty()) return;
+
+      // Crop to the work area: that is what the overlay window covers
+      let image = source.thumbnail;
+      const { width: imageWidth } = image.getSize();
+      const scale = imageWidth / display.bounds.width;
+      const { workArea, bounds } = display;
+
+      image = image.crop({
+        x: Math.round((workArea.x - bounds.x) * scale),
+        y: Math.round((workArea.y - bounds.y) * scale),
+        width: Math.round(workArea.width * scale),
+        height: Math.round(workArea.height * scale),
+      });
+
+      if (image.getSize().width > FRAME_MAX_WIDTH) {
+        image = image.resize({ width: FRAME_MAX_WIDTH, quality: 'good' });
+      }
+
+      let jpeg = image.toJPEG(65);
+      if (jpeg.length > FRAME_MAX_BYTES) jpeg = image.toJPEG(40);
+      if (jpeg.length > FRAME_MAX_BYTES) return;
+
+      const hash = createHash('md5').update(jpeg).digest('hex');
+      if (!force && hash === lastSent.hash && seq === lastSent.seq) return;
+
+      if (!isOpen()) return;
+
+      sendJson({ t: 'frame', seq, w: workArea.width, h: workArea.height });
+      ws.send(jpeg);
+      lastSent = { hash, seq };
+    } catch (error) {
+      log('Remote: capture failed', error.message);
+    } finally {
+      capturing = false;
+    }
+  }
+
+  return {
+    enable() {
+      wanted = true;
+      store.set('remote_enabled', true);
+      open();
+    },
+
+    disable() {
+      wanted = false;
+      store.set('remote_enabled', false);
+      close();
+      setStatus('disconnected');
+    },
+
+    reconnect() {
+      if (!wanted) return;
+
+      close();
+      open();
+    },
+
+    newRoom() {
+      store.set('remote_room_id', randomBytes(16).toString('hex'));
+      this.reconnect();
+      onStateChange();
+    },
+
+    sendOverlayState,
+
+    async getState() {
+      const url = padUrl();
+
+      return {
+        enabled: wanted,
+        status,
+        padConnected,
+        relayUrl: store.get('remote_relay_url') || '',
+        padUrl: url,
+        qrDataUrl: url ? await QRCode.toDataURL(url, { margin: 1, width: 280 }) : null,
+      };
+    },
+  };
+}
